# ImSky Environment Configuration
# Copy this file to .env and fill in your actual values

# WebSocket URL
VITE_APP_WS_URL=wss://imsky.example.com/ws

# Official site URL
VITE_APP_URL_OFFICIAL_SITE=https://imsky.example.com

# Documentation site URL
VITE_APP_URL_DOCS_SITE=https://imsky.example.com/docs

# Share site URL
VITE_APP_URL_SHARE_SITE=https://imsky.example.com/share

# AI assistant site URL
VITE_APP_URL_AI_SITE=https://ai.example.com/ai

# Claw center site URL
VITE_APP_URL_CLAW_SITE=https://claw.example.com

# API proxy target (used by vite dev server)
VITE_APP_API_TARGET=https://imsky.exmay.com

# ==================== 数据源 ====================
# 会话/消息数据源：api=真实后端接口，mock=本地 Mock，local=本地演示数据
# 未配置时：dev 默认 local；调试面板 API target 指向非 localhost 时自动切 api
VITE_DATA_SOURCE=api

# API base URL (production - used directly by API client; dev uses '' with vite proxy)
VITE_APP_API_BASE_URL=https://imsky.exmay.com

# ==================== 真实 IM ====================
# 真实 IM（@exmay/im-sdk WebSocket 链路）：1=开启，0=本地演示数据
VITE_IM_REAL=0
# IM WebSocket 网关
VITE_IM_WS_URL=wss://imsky.exmay.com/exmay/im
# IM 应用标识（网关鉴权用）
VITE_APP_ID=imsky
# SRS WebRTC 流媒体地址（留空禁用通话媒体面）
VITE_SRS_URL=
